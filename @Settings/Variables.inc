[Variables]
;=========================================;
;===========Set These Variables===========;
;=========================================;

;Set Your Maximum Upload Speed Here;
NetworkMaxUp=10950000

;Set your Maximum Download Speed Here;
NetworkMaxDown=790000

; Optional hardware/display settings
DiskDriveC=C:\
DiskDriveD=D:\
ShowDiskD=1
ShowCpuCore1=1
ShowCpuCore2=1
ShowCpuCore3=1
ShowCpuCore4=1

; Dashboard colors
WHITE=255,255,255,255
; Font color (bright red)
BRIGHTRED=255,0,0,255

; User-customizable font color (used by main skin text meters)
FONT_COLOR=204,255,178,255
; User-customizable bar color (used by CPU, RAM, SWAP, Disk bars)
BAR_COLOR=85,255,0,255

; User-customizable font color (used by Panchang skin text meters)
; Change this with the palette in ColorSettings rather than by hand.
PANCHANG_FONT_COLOR=170,255,0,255

; Hindu Panchang settings
PANCHANG_COUNTRY=India
PANCHANG_CITY=Anantapur
PANCHANG_TIMEZONE=Asia/Kolkata
PANCHANG_CALENDAR=telugu-amanta
PANCHANG_REGION=south-indian
PANCHANG_MONTH_START=amavasya
PANCHANG_SHOW_SHAKA=1
PANCHANG_SHOW_VIKRAM=1

